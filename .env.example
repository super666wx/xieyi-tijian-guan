# 云托管环境变量示例（复制成 .env 只是本地参考；平台部署时在面板里逐条填）
# 说明：环境变量优先级高于 config.json；config.json 不进镜像 / 不进仓库（见 .dockerignore 与 .gitignore）。

# 服务端口与监听地址（Dockerfile 里已设默认值，容器平台会覆盖 PORT）
PORT=8080
HOST=0.0.0.0

# 访问口令：留空则免登录（只适合本机自用）；部署到公网必须填
ACCESS_USER=hfk
ACCESS_PASSWORD=

# 云端模型（可换成任何 OpenAI 兼容接口）
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=

# 追问助手：1 开启 / 0 关闭
CHAT_ENABLED=1
